# Data Collector Environment Variables
# Copy to .env and fill in actual values

# Required
DATA_COLLECTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_collector

# Optional (with defaults)
DATA_COLLECTOR_SERVICE_NAME=data-collector
DATA_COLLECTOR_PORT=8151
DATA_COLLECTOR_ENVIRONMENT=production
DATA_COLLECTOR_LOG_LEVEL=INFO
DATA_COLLECTOR_LOG_FORMAT=json
DATA_COLLECTOR_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
